# ─── Database ───
DB_USER=crypto
DB_PASSWORD=crypto_dev_pass
DB_NAME=crypto_dashboard
DB_PORT=5432
DATABASE_URL=postgresql://crypto:crypto_dev_pass@localhost:5432/crypto_dashboard

# ─── Redis ───
REDIS_PASSWORD=redis_dev_pass
REDIS_PORT=6379
REDIS_URL=redis://:redis_dev_pass@localhost:6379

# ─── Backend ───
BACKEND_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── DexScreener (public, no key needed) ───
DEXSCREENER_API=https://api.dexscreener.com

# ─── GeckoTerminal (public, no key needed) ───
GECKOTERMINAL_API=https://api.geckoterminal.com/api/v2

# ─── X / Twitter API ───
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here

# ─── Bitget API ───
BITGET_API_KEY=your_bitget_api_key_here
BITGET_API_SECRET=your_bitget_api_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here

# ─── JWT ───
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
